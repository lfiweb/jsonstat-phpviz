{
  "name": "lfiweb/jsonstat-phpviz",
  "description": "Render JSON-stat data as multidimensional html tables",
  "minimum-stability": "stable",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Simon Speich",
      "email": "simon.speich@wsl.ch"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "../spreadsheet-writer"
    }
  ],
  "require": {
    "ext-dom": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "nafidas/spreadsheet-writer": "@dev",
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "10.*"
  },
  "autoload": {
    "psr-4": {
      "jsonstatPhpViz\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "jsonstatPhpViz\\Test\\": "tests/phpunit/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "preferred-install": "dist",
    "optimize-autoloader": true
  }
}